#include <stdio.h>

int main(){

    int i,n,count=1;
    printf("enter value of n");
    scanf("%d",&n);

    if(n<=1){
        count =0;
    }

    for(i=2; i<n; i++){
        if(n % i == 0){
            count = 0;
            break;
        }
    }
    if(count == 1)
    {
    printf("prime number");
    }
    else{
        printf("not prime number");
    }
     return 0;
