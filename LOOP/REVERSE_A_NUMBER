#include <stdio.h>

int main(){
   
    int i,n,rev=0,rem;

    printf("enter value of n:");
    scanf("%d",&n);

    i=n;
    while(i>=0)
    {
        rem = i%10;
        rev = rev*10+rem;
        i=i/10;
    }

    printf("reverse of %d is %d",n,rev);
    return 0;
}

