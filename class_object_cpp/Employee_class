#include<iostream>
using namespace std;
class Employee
{
    private:
    int id;
    string name;
    float salary;

    public:
    void getData(){
        cout<<"Enter employee id: ";
        cin>>id;
        cout<<"Enter employee name: ";
        cin>>name;
        cout<<"Enter employee salary: ";
        cin>>salary;
    }
    void displayData(){
        cout<<"Employee id: "<<id<<endl;
        cout<<"Employee name: "<<name<<endl;
        cout<<"Employee salary: "<<salary<<endl;
    }
};
int main(){
    Employee e;
    e.getData();
    e.displayData();
}
