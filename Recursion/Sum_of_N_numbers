#include <stdio.h>
int sum(int n){
    if(n==0){
        return 0;
    }
    else{
        return n+sum(n-1);
    }
}
int main(){
    int n;
    printf("enter value of n: ");
    scanf("%d", &n);
    int result = sum(n);
    printf("sum of first %d natural numbers is %d\n", n, result);
     return 0;
}
