#include <stdio.h>

int main(){

    int n[5],sum=0;
    int *p = &sum;

    printf("enter 5 values of array:");

    for(int i=0;i<5;i++){
        scanf("%d",&n[i]);
        sum+=n[i];
    }
    printf("sum of array elements: %d\n",sum);
    printf("sum of array elements using pointer: %d\n",*p);
     return 0;
}
