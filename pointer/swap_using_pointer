#include <stdio.h>

int main(){

    int a,b;
    printf("enter two values of a,b :");
    scanf("%d %d",&a,&b);
    printf("value of a and b before swapping: %d %d\n",a,b);

    int *p1=&a;
    int*p2=&b;
    int *c;
    c=p1;
    p1=p2;
    p2=c;

    printf("value of a using pointer a= %d\n",*p1);
    printf("value of b using pointer b= %d\n",*p2);
     return 0;
}
