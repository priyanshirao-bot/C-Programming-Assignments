#include <stdio.h>
int fact(int n){

    int fact=1,i;

    for(int i=1; i<=n; i++)
    {
        fact= fact*i;
    }
    return fact;
}     
    int main(){
        
    int n,result; 
    printf("enter value of n");
    scanf("%d",&n);   

    result=fact(n);
    
    printf("factorial of %d is %d\n",n,result);
    
     return 0;
    }
