#include <stdio.h>
int is_prime(int n){

    int i,flag=0;

    for(i=2;i<=n/2;i++)
    {
        if(n%i==0)
        {
            flag=1;
            break;
        }
    }
    if(flag==0)
        return 1;
    else
        return 0;
}
int main(){
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);
    if(is_prime(n))
        printf("%d is a prime number.\n", n);
    else
        printf("%d is not a prime number.\n", n);
    return 0;
}
