#include <iostream>
#include <vector>
int main() {
    std::vector<int> vec = {1, 2, 3, 4, 5};
    int max = vec[0];
    int min = vec[0];
    for (int i : vec) {
        if (i > max) {
            max = i;
        }
        if (i < min) {
            min = i;
        }
    }
    std::cout << "Maximum element: " << max << std::endl;
    std::cout << "Minimum element: " << min << std::endl;
    return 0;
}
