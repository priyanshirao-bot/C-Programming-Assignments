#include <stdio.h>

int main(){

    int arr[4];
    printf("Enter 4 elements of array: ");
    for(int i=0; i<4; i++){
        scanf("%d",&arr[i]);
    }
    int max =arr[0];
    for(int i=1;i<4; i++){
        if(arr[i]>max){

            max = arr[i];
        }
    }
    printf("Maximum element of array is: %d", max);
    return 0;
}
