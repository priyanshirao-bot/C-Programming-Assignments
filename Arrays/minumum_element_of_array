#include <stdio.h>

int main(){

    int arr[4];
    printf("Enter 4 elements of array: ");
    for(int i=0; i<4; i++){
        scanf("%d",&arr[i]);
    }
    int min =arr[0];
    for(int i=1;i<4; i++){
        if(arr[i]<min){

            min = arr[i];
        }
    }
    printf("Minimum element of array is: %d", min);
    return 0;
}
