#include <stdio.h>

int main(){

    int arr[4];
    printf("enter values of array");

    for(int i=0;i<4;i++){
        scanf("%d",&arr[i]);

    }
    int max =arr[0];
    int second_max = arr[0];
    for(int i=0;i<4;i++){
        if(arr[i]>max){
            second_max = max;
            max= arr[i];
        }
        else if(arr[i]>second_max && arr[i] != max){
            second_max = arr[i];
        }
        
    } printf("second largest element of array is: %d", second_max);
     return 0;
}
