#include <stdio.h>

int main(){

    char str[8];
    printf("enter string:");
    scanf("%s",&str[0]);
    int count =0;
    for(int i=0;str[i]!='\0';i++){
        if(str[i]=='a' || str[i]=='e' || str[i]=='i' || str[i]=='o' || str[i]=='u' || str[i]=='A' || str[i]=='E' || str[i]=='I' || str[i]=='O' || str[i]=='U'){
            count++;
        }
    }
    printf("number of vowels in string is: %d", count);
    
     return 0;
}
